{
  "name": "markdoist-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Markdoist – lokale Markdown-Todo-App",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:tz": "node scripts/test-tz-matrix.mjs",
    "e2e:desktop": "pnpm --filter desktop build && pnpm --filter desktop exec playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "type": "module"
}
